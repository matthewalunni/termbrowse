{
  "name": "termbrowse",
  "version": "0.1.0",
  "description": "One Chrome for Testing per AI agent through the chrome-devtools MCP server, which you can watch live in a terminal pane via Kitty graphics.",
  "author": {
    "name": "Matthew Alunni"
  },
  "homepage": "https://github.com/matthewalunni/termbrowse",
  "repository": "https://github.com/matthewalunni/termbrowse",
  "license": "MIT",
  "keywords": [
    "browser",
    "chrome",
    "mcp",
    "terminal",
    "kitty"
  ],
  "mcpServers": {
    "chrome-devtools": {
      "command": "termbrowse",
      "args": [
        "mcp"
      ]
    }
  }
}
